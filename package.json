		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
