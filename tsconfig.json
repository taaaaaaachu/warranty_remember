{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts"
	],
	// Service Worker は専用の tsconfig(src/service-worker/tsconfig.json)で型チェックする。
	"exclude": ["src/service-worker"]
}
